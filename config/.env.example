# Wellness Call System - Environment Variables
# Copy this file to .env and fill in your actual values

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Configuration  
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs Configuration
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Numbers
WELLNESS_FROM_NUMBER=+1XXXXXXXXXX    # Your Twilio number
WELLNESS_TO_NUMBER=+1XXXXXXXXXX      # Patient's phone number
TEST_PHONE_NUMBER=+1XXXXXXXXXX       # Your test number

# ngrok Configuration (optional)
NGROK_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom voice settings
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (default)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional: Model overrides  
RESPONSE_MODEL=anthropic/claude-sonnet-4-20250514
STT_MODEL=whisper-1